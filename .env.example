# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=3000
NODE_ENV=development

# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eleczz

# ---- Cloud-hosted MySQL only (Aiven, Clever Cloud, PlanetScale, RDS, etc.) ----
# Leave both commented out for a MySQL server on your own machine.
# DB_SSL=true
# DB_SSL_CA=/path/to/the-host's-ca-certificate.pem   (optional; omit to skip certificate verification)

# ---- Login security ----
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
